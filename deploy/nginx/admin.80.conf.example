# Reference template. deploy-remote.sh renders the active vhost from deploy.env.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN_ADMIN};
    location ^~ /.well-known/acme-challenge/ {
        root ${REMOTE_WEB_ROOT}/${DOMAIN_ADMIN};
        allow all;
        default_type text/plain;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
