# Copy this file to deploy/deploy.env and fill in the three required values.
# deploy/deploy.env is ignored by Git. Do not put passwords or secret keys here.

# Required deployment target
SERVER_HOST=your-ssh-host
DOMAIN_CONTEST=contest.example.com
DOMAIN_ADMIN=admin.example.com

# Local release source, resolved relative to this config file
LOCAL_DIR=../server

# Remote layout
REMOTE_WEB_ROOT=/var/www/mini-oj
REMOTE_BACKUP_ROOT=/var/backups/mini-oj
REMOTE_SECRETS_DIR=/etc/mini-oj
REMOTE_NODE_BIN=/usr/local/bin

# Processes and ports
CONTEST_PORT=3001
ADMIN_PORT=3002
PM2_CONTEST_NAME=mini-oj-contest
PM2_ADMIN_NAME=mini-oj-admin

# Authoritative judge toolchains
C_COMPILER=/usr/bin/gcc-11
CPP_COMPILER=/usr/bin/g++-11
JAVA_JAVAC_BIN=/usr/lib/jvm/java-21-openjdk-amd64/bin/javac
JAVA_BIN=/usr/lib/jvm/java-21-openjdk-amd64/bin/java

# First-time Nginx bootstrap (used by deploy/deploy-remote.sh)
NGINX_VHOST_DIR=/etc/nginx/conf.d
NGINX_LOG_DIR=/var/log/nginx
NGINX_BIN=nginx
CERTBOT_BIN=certbot

# Optional Docker Compose host port
COMPOSE_HTTP_PORT=8080
