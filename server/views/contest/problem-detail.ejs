<%
  var cid = (typeof contestId !== 'undefined') ? contestId : '';
  var pid = (typeof problemId !== 'undefined') ? problemId : '';
%>
<%- include('../partials/contest-head', { title: '题目详情', nav: 'problems', contestId: cid }) %>
<% var pageScript = '/js/contest/problem-detail.js' %>

<div class="problem-page problem-detail-page">
  <section class="contest-tactical-bar" id="contest-tactical-bar" aria-label="赛事战术状态">
    <div class="contest-tactical-stat">
      <span class="contest-tactical-label">已进行</span>
      <strong class="contest-tactical-value" id="contest-elapsed"></strong>
    </div>
    <div class="contest-tactical-stat">
      <span class="contest-tactical-label">已解决</span>
      <strong class="contest-tactical-value" id="contest-solved"></strong>
    </div>
    <nav class="contest-problem-rail" id="contest-problem-rail" aria-label="题目状态"></nav>
  </section>

  <div class="problem-workspace">
    <section class="problem-statement-pane panel-oj" aria-label="题目描述">
      <header class="problem-topbar">
        <div class="problem-topbar-head">
          <div class="problem-topbar-main">
            <a class="problem-back" href="/contest/contests/<%= cid %>/problems">返回题目列表</a>
            <div class="problem-titlebar">
              <span class="mono text-muted problem-title-letter" id="p-letter">-</span>
              <h1 class="problem-title" id="p-title">加载中…</h1>
              <span class="problem-contest" id="p-contest"></span>
            </div>
          </div>
          <span class="problem-pane-tools" aria-label="题面工具">
            <button class="problem-pane-tool" type="button" data-problem-action="top" title="返回题面顶部">目录</button>
            <button class="problem-pane-tool" type="button" data-problem-action="fullscreen" title="切换题面全屏">全屏阅读</button>
          </span>
        </div>
        <div class="problem-meta" aria-label="题目限制与统计">
          <div class="problem-meta-item"><span class="k">时间限制</span><b class="mono" id="p-time">-</b></div>
          <div class="problem-meta-item"><span class="k">内存限制</span><b class="mono" id="p-mem">-</b></div>
          <div class="problem-meta-item"><span class="k">测试点</span><b class="mono" id="p-cases">-</b></div>
          <div class="problem-meta-item"><span class="k">提交数</span><b class="mono" id="p-subcnt">-</b></div>
          <div class="problem-meta-item"><span class="k">通过率</span><b class="mono" id="p-acrate">-</b></div>
        </div>
      </header>
      <div class="problem-pane-heading panel-heading">
        <span>题目描述</span>
        <span class="problem-pane-tools" aria-label="题面工具">
          <span class="text-muted">Statement</span>
        </span>
      </div>
      <div class="problem-statement-scroll panel-body">
        <div id="p-desc" class="md_display_div"></div>
      </div>
    </section>

    <div class="problem-splitter" id="problem-splitter" role="separator" aria-orientation="vertical" aria-label="调整题面和代码宽度" aria-valuemin="28" aria-valuemax="58" aria-valuenow="40" tabindex="0">
      <span class="problem-splitter-handle" aria-hidden="true"></span>
    </div>

    <section class="problem-code-pane" aria-label="代码编辑器">
      <!-- Web IDE：统一浏览器运行环境 -->
      <div class="problem-code-workbench">
        <div class="ide-toolbar">
          <div class="ide-toolbar-title">
            <span class="ide-toolbar-label">Web IDE</span>
            <span class="ide-toolbar-status text-muted" id="runtime-status"></span>
          </div>
          <div class="ide-actionbar" role="toolbar" aria-label="代码运行工具栏">
            <span class="oj-tt-wrap ide-language-wrap" id="ide-lang-tt">
              <select class="form-control ide-language-select" id="ide-lang">
                <option value="c">C11</option>
                <option value="cpp">C++11</option>
                <option value="c17">C17</option>
                <option value="cpp17">C++17</option>
                <option value="python">Python 3.12</option>
                <option value="java">Java 21</option>
              </select>
              <!-- Tooltip 卡片由 JS 动态填充 -->
              <div class="oj-tt-card" id="ide-lang-tooltip"></div>
            </span>
            <select class="form-control ide-opt-select" id="ide-opt" title="本地运行默认快速编译(-O0)；性能模式(-O2)用于估算程序运行性能">
              <option value="-O0">快速编译 (-O0)</option>
              <option value="-O2">性能模式 (-O2)</option>
            </select>
            <button class="btn btn-default btn-sm ide-runtime-btn" id="ide-runtime-detail" type="button" title="查看运行环境详情">运行环境详情</button>
            <label class="text-muted ide-pch-option" title="自动 PCH：含 bits/stdc++.h 用 bits.pch，含 iostream 用 iostream.pch，否则不预编译。可显著缩短 STL 头解析（一次性生成成本约 1s，常驻浏览器）">
              <input type="checkbox" id="ide-pch" checked> PCH 加速（自动）
            </label>
          </div>
        </div>

        <details class="problem-runtime-info">
          <summary>浏览器运行环境</summary>
          <div class="problem-runtime-info-body">
            「运行代码」与「运行样例」均在<b>你的浏览器（WebAssembly）</b>内本地执行，<b>不安装任何软件、不接触隐藏测试点</b>。<br>
            <span class="text-muted">首次使用可能从服务器下载并缓存静态运行环境；Runtime Ready 后，本地运行过程中源码、自定义输入及本地执行结果不发送至判题服务器。</span><br>
            · C11：浏览器本地运行；正式评测：GCC 11<br>
            · C++11：浏览器本地运行；正式评测：G++ 11<br>
            · C17：浏览器本地运行；正式评测：GCC 14<br>
            · C++17：浏览器本地运行；正式评测：G++ 14<br>
            · Python 3.12：浏览器本地运行；正式评测：CPython 3.12<br>
            · Java 21：浏览器本地运行；正式评测：OpenJDK 21<br>
            本地运行结果仅供自测参考，正式评测由<b>服务器</b>执行。
          </div>
        </details>

        <!-- Runtime Loading 进度条（JS 控制显隐） -->
        <div class="oj-runtime-progress ide-runtime-progress" id="runtime-progress">
          <div class="oj-runtime-progress-head">
            <span class="oj-runtime-progress-stage" id="rp-stage">正在准备…</span>
            <span class="oj-runtime-progress-pct" id="rp-pct">0%</span>
          </div>
          <div class="oj-runtime-progress-bar"><div class="oj-runtime-progress-fill" id="rp-fill"></div></div>
          <div class="oj-runtime-progress-bytes" id="rp-bytes"></div>
          <div class="oj-runtime-progress-error" id="rp-error" style="display:none">
            <span id="rp-error-msg"></span>
            <button class="oj-runtime-progress-retry" id="rp-retry" type="button">重试</button>
          </div>
        </div>

        <div class="ide-editor-surface">
          <!-- 代码编辑器 -->
          <textarea class="editor-oj ide-code-editor" id="ide-code" spellcheck="false" placeholder="#include <iostream>
int main() { /* 在这里书写你的代码 */ return 0; }"></textarea>
        </div>

        <div class="ide-console-splitter" role="separator" aria-orientation="horizontal" aria-label="调整运行结果高度">
          <span class="ide-console-splitter-handle" aria-hidden="true"></span>
        </div>

        <section class="ide-console" aria-label="运行结果与输入">
          <div class="ide-console-heading">
            <span class="ide-console-title">运行面板</span>
            <span class="ide-console-tabs" role="tablist" aria-label="运行面板内容">
              <button type="button" role="tab" aria-selected="false" data-console-target="ide-output-wrap">运行结果</button>
              <button type="button" role="tab" aria-selected="false" data-console-target="ide-samples-wrap">样例测试</button>
              <button type="button" role="tab" aria-selected="true" data-console-target="ide-input-wrap">自定义输入</button>
            </span>
          </div>
          <div class="ide-console-body">
            <!-- 自定义输入 -->
            <div class="ide-console-section" id="ide-input-wrap">
              <div class="text-muted ide-console-label">自定义输入（stdin）</div>
              <textarea class="form-control editor-oj ide-input-editor" id="ide-input" rows="3" spellcheck="false" placeholder="在此输入标准输入，点击「运行代码」将在浏览器内本地执行"></textarea>
            </div>

            <!-- 运行结果 -->
            <div class="ide-console-section" id="ide-output-wrap" style="display:none">
              <div class="text-muted ide-console-label">运行结果</div>
              <div class="flex-between">
                <span id="ide-output-head" class="mono text-muted"></span>
                <span id="ide-time" class="ide-time-value"></span>
              </div>
              <div id="ide-timing" class="text-muted ide-timing-value"></div>
              <pre class="output-oj" id="ide-output"></pre>
            </div>

            <!-- 每次 Local Run 后的编译详情可折叠区（JS 控制显隐） -->
            <details class="oj-compile-detail ide-compile-detail" id="ide-compile-detail" style="display:none">
              <summary>查看编译详情</summary>
              <div class="oj-compile-detail-body" id="ide-compile-detail-body"></div>
            </details>

            <!-- 样例自测结果 -->
            <div class="ide-console-section" id="ide-samples-wrap" style="display:none">
              <div class="text-muted ide-console-label">公开样例自测</div>
              <div id="ide-samples-result"></div>
            </div>
          </div>
        </section>

        <section class="ide-submit-panel panel-oj" aria-label="正式提交">
          <div class="ide-bottom-actionbar" role="toolbar" aria-label="提交与运行操作">
            <div class="ide-primary-actions">
              <button class="btn btn-info btn-sm ide-samples-btn" id="ide-run-samples" type="button">运行样例</button>
              <button class="btn btn-primary btn-sm ide-run-btn" id="ide-run" type="button">运行代码</button>
              <button class="btn btn-primary ide-submit-btn" id="submit-btn">正式提交</button>
            </div>
            <span class="ide-submit-status" id="precheck-status"></span>
          </div>
          <div class="ide-submit-heading panel-heading">
            <span>正式提交</span>
          </div>
          <div class="ide-submit-body panel-body">
            <div class="ide-submit-actionbar">
              <span class="text-muted ide-submit-note">本地自测通过仅表示公开样例通过；正式结果以服务器评测为准</span>
            </div>
            <div id="submit-preview-note" class="text-muted ide-submit-preview" style="display:none">
              当前该语言暂不支持正式提交。
            </div>
            <div id="submit-result" class="ide-submit-result" style="display:none">
              <div class="alert-oj alert-info-oj">
                <div class="flex-between">
                  <span>本次提交：<b class="mono" id="sub-id"></b></span>
                  <span id="sub-status"></span>
                </div>
                <div class="ide-submit-cases" id="sub-cases"></div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </section>
  </div>

  <!-- Runtime Detail Drawer（右侧滑入；由 JS 控制） -->
  <div class="oj-drawer-mask" id="runtime-drawer-mask"></div>
  <aside class="oj-drawer" id="runtime-drawer" role="dialog" aria-label="运行环境详情">
    <div class="oj-drawer-head">
      <h3>运行环境详情</h3>
      <button class="oj-drawer-close" id="runtime-drawer-close" aria-label="关闭">关闭</button>
    </div>
    <div class="oj-drawer-body" id="runtime-drawer-body"></div>
  </aside>
</div>

<script>
window.__CONTEST_ID__ = <%- JSON.stringify(cid) %>;
window.__PROBLEM_ID__ = <%- JSON.stringify(pid) %>;
window.__USER_ID__ = <%- JSON.stringify(user && user.id ? user.id : '') %>;
window.__MODERN_FORMAL_SUBMIT_ALLOWED__ = <%- JSON.stringify(typeof modernFormalSubmitAllowed === 'undefined' ? true : modernFormalSubmitAllowed) %>;
</script>

<!-- 浏览器运行时（Runno）：ES Module 加载，需 COOP/COEP 头 -->
<script type="module" src="/js/contest/runno-loader.js"></script>
<!-- 轻量运行管线：Artifact Cache + 分段计时 + 预热（P0/P1 性能优化） -->
<script type="module" src="/js/contest/ide-runner.js"></script>

<%- include('../partials/contest-foot', { pageScript: pageScript }) %>
