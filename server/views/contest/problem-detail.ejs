<%
  var cid = (typeof contestId !== 'undefined') ? contestId : '';
  var pid = (typeof problemId !== 'undefined') ? problemId : '';
%>
<%- include('../partials/contest-head', { title: '题目详情', nav: 'problems', contestId: cid }) %>
<% var pageScript = '/js/contest/problem-detail.js' %>

<div class="mb-16"><a href="/contest/contests/<%= cid %>/problems">← 返回题目列表</a></div>

<div class="grid-2" style="grid-template-columns: 1.6fr 1fr; align-items:start">
  <div>
    <!-- 题目描述 -->
    <div class="panel-oj">
      <div class="panel-heading">
        <span class="mono text-muted" id="p-letter" style="margin-right:10px">-</span>
        <span id="p-title">加载中…</span>
        <span class="pull-right" id="p-contest"></span>
      </div>
      <div class="panel-body">
        <div id="p-desc" class="md_display_div"></div>
      </div>
    </div>

    <!-- Web IDE：统一浏览器运行环境 -->
    <div class="panel-oj">
      <div class="panel-heading">
        Web IDE
        <span class="pull-right text-muted" style="font-size:12px" id="runtime-status"></span>
      </div>
      <div class="panel-body">
        <div class="form-group" style="margin-bottom:10px">
          <span class="oj-tt-wrap" id="ide-lang-tt">
            <select class="form-control" id="ide-lang" style="display:inline-block;width:170px">
              <option value="c">C11</option>
              <option value="cpp">C++11</option>
              <option value="c17">C17</option>
              <option value="cpp17">C++17</option>
              <option value="python">Python 3.12</option>
              <option value="java">Java 21</option>
            </select>
            <!-- Tooltip 卡片由 JS 动态填充 -->
            <div class="oj-tt-card" id="ide-lang-tooltip"></div>
          </span>
          <select class="form-control" id="ide-opt" style="display:inline-block;width:140px" title="本地运行默认快速编译(-O0)；性能模式(-O2)用于估算程序运行性能">
            <option value="-O0">快速编译 (-O0)</option>
            <option value="-O2">性能模式 (-O2)</option>
          </select>
          <button class="btn btn-primary btn-sm" id="ide-run" type="button">▶ 运行代码</button>
          <button class="btn btn-info btn-sm" id="ide-run-samples" type="button">运行样例</button>
          <button class="btn btn-default btn-sm" id="ide-runtime-detail" type="button" title="查看运行环境详情">⚙ 运行环境详情</button>
          <label class="text-muted" style="font-size:12px;margin-left:8px;cursor:pointer" title="自动 PCH：含 bits/stdc++.h 用 bits.pch，含 iostream 用 iostream.pch，否则不预编译。可显著缩短 STL 头解析（一次性生成成本约 1s，常驻浏览器）">
            <input type="checkbox" id="ide-pch" checked> PCH 加速（自动）
          </label>
        </div>

        <!-- Runtime Loading 进度条（JS 控制显隐） -->
        <div class="oj-runtime-progress" id="runtime-progress">
          <div class="oj-runtime-progress-head">
            <span class="oj-runtime-progress-stage" id="rp-stage">正在准备…</span>
            <span class="oj-runtime-progress-pct" id="rp-pct">0%</span>
          </div>
          <div class="oj-runtime-progress-bar"><div class="oj-runtime-progress-fill" id="rp-fill"></div></div>
          <div class="oj-runtime-progress-bytes" id="rp-bytes"></div>
          <div class="oj-runtime-progress-error" id="rp-error" style="display:none">
            <span id="rp-error-msg"></span>
            <button class="oj-runtime-progress-retry" id="rp-retry" type="button">重试</button>
          </div>
        </div>

        <!-- 代码编辑器 -->
        <textarea class="editor-oj" id="ide-code" spellcheck="false" placeholder="#include <iostream>
int main() { /* 在这里书写你的代码 */ return 0; }"></textarea>

        <!-- 自定义输入 -->
        <div class="mt-16" id="ide-input-wrap">
          <div class="text-muted" style="font-size:12px;margin-bottom:4px">自定义输入（stdin）</div>
          <textarea class="form-control editor-oj" id="ide-input" rows="3" spellcheck="false" placeholder="在此输入标准输入，点击「运行代码」将在浏览器内本地执行"></textarea>
        </div>

        <!-- 运行结果 -->
        <div class="mt-16" id="ide-output-wrap" style="display:none">
          <div class="text-muted" style="font-size:12px;margin-bottom:4px">运行结果</div>
          <div class="flex-between">
            <span id="ide-output-head" class="mono text-muted"></span>
            <span id="ide-time" style="font-weight:600;font-size:14px"></span>
          </div>
          <div id="ide-timing" class="text-muted" style="font-size:12px;margin:2px 0 4px"></div>
          <pre class="output-oj" id="ide-output"></pre>
        </div>

        <!-- 每次 Local Run 后的编译详情可折叠区（JS 控制显隐） -->
        <details class="oj-compile-detail" id="ide-compile-detail" style="display:none">
          <summary>查看编译详情</summary>
          <div class="oj-compile-detail-body" id="ide-compile-detail-body"></div>
        </details>

        <!-- 样例自测结果 -->
        <div class="mt-16" id="ide-samples-wrap" style="display:none">
          <div class="text-muted" style="font-size:12px;margin-bottom:4px">公开样例自测</div>
          <div id="ide-samples-result"></div>
        </div>
      </div>
    </div>

    <!-- Runtime Detail Drawer（右侧滑入；由 JS 控制） -->
    <div class="oj-drawer-mask" id="runtime-drawer-mask"></div>
    <aside class="oj-drawer" id="runtime-drawer" role="dialog" aria-label="运行环境详情">
      <div class="oj-drawer-head">
        <h3>运行环境详情</h3>
        <button class="oj-drawer-close" id="runtime-drawer-close" aria-label="关闭">✕</button>
      </div>
      <div class="oj-drawer-body" id="runtime-drawer-body"></div>
    </aside>

    <!-- 提交（正式评测走服务器 JudgeAdapter，唯一正式判定来源） -->
    <div class="panel-oj">
      <div class="panel-heading">
        正式提交
        <span class="pull-right" id="precheck-status" style="font-size:12px"></span>
      </div>
      <div class="panel-body">
        <div class="flex-between">
          <span class="text-muted" style="font-size:13px">本地自测通过仅表示公开样例通过；正式结果以服务器评测为准</span>
          <button class="btn btn-primary" id="submit-btn">正式提交</button>
        </div>
        <div id="submit-preview-note" class="text-muted" style="display:none;margin-top:8px;font-size:12px">
          当前该语言暂不支持正式提交。
        </div>
        <div id="submit-result" class="mt-16" style="display:none">
          <div class="alert-oj alert-info-oj">
            <div class="flex-between">
              <span>本次提交：<b class="mono" id="sub-id"></b></span>
              <span id="sub-status"></span>
            </div>
            <div class="mt-16" id="sub-cases"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div>
    <div class="panel-oj">
      <div class="panel-heading">限制</div>
      <div class="panel-body" style="padding:8px 15px">
        <div class="limit-row"><span class="k">时间限制</span><b class="mono" id="p-time">-</b></div>
        <div class="limit-row"><span class="k">内存限制</span><b class="mono" id="p-mem">-</b></div>
        <div class="limit-row"><span class="k">测试点数量</span><b class="mono" id="p-cases">-</b></div>
        <div class="limit-row"><span class="k">提交数</span><b class="mono" id="p-subcnt">-</b></div>
        <div class="limit-row"><span class="k">通过率</span><b class="mono" id="p-acrate">-</b></div>
      </div>
    </div>
    <div class="panel-oj">
      <div class="panel-heading">浏览器运行环境</div>
      <div class="panel-body" style="font-size:13px;line-height:1.9">
        「运行代码」与「运行样例」均在<b>你的浏览器（WebAssembly）</b>内本地执行，<b>不安装任何软件、不接触隐藏测试点</b>。<br>
        <span style="color:#6b7280">首次使用可能从服务器下载并缓存静态运行环境；Runtime Ready 后，本地运行过程中源码、自定义输入及本地执行结果不发送至判题服务器。</span><br>
        · C11：浏览器本地运行；正式评测：GCC 11<br>
        · C++11：浏览器本地运行；正式评测：G++ 11<br>
        · C17：浏览器本地运行；正式评测：GCC 14<br>
        · C++17：浏览器本地运行；正式评测：G++ 14<br>
        · Python 3.12：浏览器本地运行；正式评测：CPython 3.12<br>
        · Java 21：浏览器本地运行；正式评测：OpenJDK 21<br>
        本地运行结果仅供自测参考，正式评测由<b>服务器</b>执行。
      </div>
    </div>
  </div>
</div>

<script>
window.__CONTEST_ID__ = <%- JSON.stringify(cid) %>;
window.__PROBLEM_ID__ = <%- JSON.stringify(pid) %>;
window.__USER_ID__ = <%- JSON.stringify(user && user.id ? user.id : '') %>;
window.__MODERN_FORMAL_SUBMIT_ALLOWED__ = <%- JSON.stringify(typeof modernFormalSubmitAllowed === 'undefined' ? true : modernFormalSubmitAllowed) %>;
</script>

<!-- 浏览器运行时（Runno）：ES Module 加载，需 COOP/COEP 头 -->
<script type="module" src="/js/contest/runno-loader.js"></script>
<!-- 轻量运行管线：Artifact Cache + 分段计时 + 预热（P0/P1 性能优化） -->
<script type="module" src="/js/contest/ide-runner.js"></script>

<%- include('../partials/contest-foot', { pageScript: pageScript }) %>
