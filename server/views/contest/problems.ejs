<%
  var cid = (typeof contestId !== 'undefined') ? contestId : '';
%>
<%- include('../partials/contest-head', { title: '题目', nav: 'problems', contestId: cid }) %>
<% var pageScript = '/js/contest/problems.js' %>

<div class="flex-between mb-16">
  <h2 class="page-title">题目 <span class="mono text-muted" id="contest-title" style="font-size:14px"></span></h2>
  <div class="mono text-muted">排队 <b id="stat-pending">0</b> · 可信 Worker <b id="stat-workers">0</b></div>
</div>

<div class="panel-oj">
  <table class="table-oj table-striped table-hover" style="margin-bottom:0">
    <thead>
      <tr>
        <th style="width:80px;text-align:center">题号<br>ID</th>
        <th>标题<br>Title</th>
        <th style="width:90px;text-align:right">通过<br>AC</th>
        <th style="width:90px;text-align:right">提交<br>Submit</th>
      </tr>
    </thead>
    <tbody id="problem-tbody">
      <tr><td colspan="4" class="empty">加载中…</td></tr>
    </tbody>
  </table>
</div>

<script>window.__CONTEST_ID__ = '<%= cid %>';</script>

<%- include('../partials/contest-foot', { pageScript: pageScript }) %>
