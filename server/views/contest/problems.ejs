<%
  var cid = (typeof contestId !== 'undefined') ? contestId : '';
%>
<%- include('../partials/contest-head', { title: '题目', nav: 'problems', contestId: cid }) %>
<% var pageScript = '/js/contest/problems.js' %>

<div class="contest-page contest-problems-page">
  <div class="contest-page-head">
    <div class="contest-page-head-main">
      <div class="contest-kicker">CONTEST PROBLEMS</div>
      <h1 class="page-title contest-page-title">题目 <span class="mono text-muted contest-title-code" id="contest-title"></span></h1>
      <p class="contest-page-lead">按题号进入答题工作台，实时查看本场比赛的通过与提交统计。</p>
    </div>
    <div class="contest-page-head-meta" aria-label="正式评测队列">
      <span class="contest-meta-label">判题队列</span>
      <div class="contest-summary-bar" role="status" aria-live="polite">
        <span class="contest-summary-label">正式判题队列</span>
        <b id="stat-pending">0</b>
        <span class="contest-summary-note">· 服务器 JudgeAdapter</span>
      </div>
    </div>
  </div>

  <section class="panel-oj contest-section contest-table-shell contest-problems-shell" aria-label="比赛题目列表">
    <div class="contest-table-note">
      <span class="contest-table-note-title">题目列表</span>
      <span class="contest-table-note-meta">点击题目进入答题工作台 · 通过 / 提交为官方统计</span>
    </div>
    <table class="table-oj table-striped table-hover contest-table">
    <thead>
      <tr>
        <th class="contest-col-id" scope="col"><span class="table-head-main">题号</span><span class="table-head-sub">ID</span></th>
        <th class="contest-col-title" scope="col"><span class="table-head-main">标题</span><span class="table-head-sub">Title</span></th>
        <th class="contest-col-count" scope="col"><span class="table-head-main">通过</span><span class="table-head-sub">AC</span></th>
        <th class="contest-col-count" scope="col"><span class="table-head-main">提交</span><span class="table-head-sub">Submit</span></th>
      </tr>
    </thead>
    <tbody id="problem-tbody">
      <tr><td colspan="4" class="empty">加载中…</td></tr>
    </tbody>
    </table>
  </section>
</div>

<script>window.__CONTEST_ID__ = '<%= cid %>';</script>

<%- include('../partials/contest-foot', { pageScript: pageScript }) %>
