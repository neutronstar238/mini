<%- include('../partials/contest-head', { title: '我的提交', nav: 'submissions' }) %>
<% var pageScript = '/js/contest/submissions.js' %>

<div class="flex-between mb-16">
  <h2 class="page-title">我的提交</h2>
  <div class="mono text-muted">排队 <b id="pending-count">0</b></div>
</div>

<div class="toolbar-oj">
  <div class="form-group">
    <label>结果</label>
    <select class="form-control" id="f-status" style="display:inline-block;width:150px">
      <option value="all">全部</option>
      <option value="SUBMITTED">SUBMITTED</option>
      <option value="PENDING">PENDING</option>
      <option value="LEASED">LEASED</option>
      <option value="RUNNING">RUNNING</option>
      <option value="VERIFYING">VERIFYING</option>
      <option value="AC">AC</option>
      <option value="WA">WA</option>
      <option value="TLE">TLE</option>
      <option value="MLE">MLE</option>
      <option value="RE">RE</option>
      <option value="CE">CE</option>
      <option value="SE">SE</option>
    </select>
  </div>
</div>

<div class="panel-oj">
  <table class="table-oj table-striped table-hover" style="margin-bottom:0">
    <thead>
      <tr>
        <th style="width:80px">RunID</th>
        <th>Problem</th>
        <th style="width:90px">Lang</th>
        <th style="width:110px">Result</th>
        <th style="width:90px;text-align:right">Time</th>
        <th style="width:90px;text-align:right">Memory</th>
        <th style="width:160px">Local Precheck</th>
        <th style="width:150px">Submit Time</th>
      </tr>
    </thead>
    <tbody id="sub-tbody"><tr><td colspan="8" class="empty">加载中…</td></tr></tbody>
  </table>
  <div class="flex-between" style="padding:8px 12px;border-top:1px solid #eee">
    <span class="text-muted mono" id="page-info" style="font-size:12px"></span>
    <div><button class="btn btn-default btn-sm" id="prev-page">上一页</button> <button class="btn btn-default btn-sm" id="next-page">下一页</button></div>
  </div>
</div>

<%- include('../partials/contest-foot') %>
