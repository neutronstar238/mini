<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Mini-OJ</title>
  <!-- 亮蓝白现代风格（仿 CCPCOJ） -->
  <link rel="stylesheet" href="/css/ccpcoj.css">
</head>
<body class="cpc-body">
  <!-- 顶部导航（深色模块条） -->
  <div class="cpc-navbar <%= (typeof navClass !== 'undefined' && navClass) ? 'cpc-navbar-' + navClass : '' %>">
    <button type="button" class="cpc-nav-toggle navbar-toggle" onclick="document.querySelector('.sidebar').classList.toggle('show')">
      <span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span>
    </button>
    <a class="cpc-brand" href="/problems">Mini-OJ</a>
    <span class="cpc-brand-subtitle">
      <%= (typeof subtitle !== 'undefined' && subtitle) ? subtitle : '本地评测网格' %>
    </span>
  </div>

  <header class="cpc-header">
    <ul id="sidebar_div" class="sidebar">
      <li class="user_panel">
        <% if (user) { %>
          <div style="padding: 4px 0 8px;">
            <span class="text-primary" style="font-weight:bold"><%= user.nickname || user.username %></span>
            <span class="label label-default"><%= user.role === 'admin' ? '管理员' : '选手' %></span>
          </div>
          <div style="padding-bottom: 6px;">
            <button class="btn btn-default btn-sm" id="logout-btn" style="width:100%">退出登录</button>
          </div>
        <% } else { %>
          <a href="/login" class="btn btn-success btn-sm" style="width:100%;margin:4px 0">登录 / 注册</a>
        <% } %>
      </li>
      <hr>
      <li <%= (typeof nav === 'undefined' || nav === 'problems') ? 'class="active"' : '' %>>
        <a href="/problems">题目</a>
      </li>
      <li <%= (typeof nav !== 'undefined' && nav === 'submissions') ? 'class="active"' : '' %>>
        <a href="/submissions">提交状态</a>
      </li>
      <% if (user && user.role === 'admin') { %>
      <li <%= (typeof nav !== 'undefined' && nav === 'admin') ? 'class="active"' : '' %>>
        <a href="/admin">管理后台</a>
      </li>
      <li <%= (typeof nav !== 'undefined' && nav === 'devices') ? 'class="active"' : '' %>>
        <a href="/admin/devices">设备监控</a>
      </li>
      <% } %>
      <li>
        <a href="/queue-screen" target="_blank">现场队列</a>
      </li>
      <hr>
    </ul>
  </header>

  <main class="cpc-main">
