  </main>

  <!-- 页脚版权（部署上线时按需补充备案信息，仓库内不保留个人备案号） -->
  <footer class="cpc-footer contest-footer">
    <div class="flex-between contest-footer-inner">
      <span class="contest-footer-note">Mini-OJ · 浏览器本地预检 + 服务器权威判题</span>
    </div>
  </footer>

  <div id="toast-root"></div>
  <script src="/js/common.js"></script>
  <script src="/js/contest/device-heartbeat.js"></script>
  <script>
    (function () {
      var brandSubtitle = document.getElementById('contest-brand-subtitle');
      if (brandSubtitle && window.__CONTEST_ID__) {
        api('/api/contest/contests/' + window.__CONTEST_ID__).then(function (result) {
          if (result && result.contest && result.contest.title) brandSubtitle.textContent = result.contest.title;
        }).catch(function () {});
      }
      var btn = document.getElementById('logout-btn');
      if (btn) btn.addEventListener('click', async function () {
        try { await api('/api/contest/auth/logout', { method: 'POST' }); } catch (_) {}
        localStorage.removeItem('token');
        location.href = '/contest/login';
      });
    })();
  </script>
  <% if (typeof pageScript !== 'undefined' && pageScript) { %>
  <script src="<%= pageScript %>"></script>
  <% } %>
</body>
</html>
