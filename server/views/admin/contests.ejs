<%- include('../partials/admin-head', { title: '比赛管理', nav: 'contests' }) %>
<% var pageScript = '/js/admin/contests.js' %>

<h2 class="page-title">比赛管理</h2>
<div class="flex-between mb-16"><span class="text-muted">发布比赛并设置开始时间；未到时间选手端不可进入</span><button class="btn btn-primary btn-sm" id="new-contest-btn">+ 发布比赛</button></div>

<div class="panel-oj">
  <table class="table-oj table-striped table-hover" style="margin-bottom:0">
    <thead><tr>
      <th style="width:60px">ID</th>
      <th>标题</th>
      <th style="width:80px">题目</th>
      <th style="width:140px">开始时间</th>
      <th style="width:90px">状态</th>
      <th style="width:180px">操作</th>
    </tr></thead>
    <tbody id="contest-tbody"><tr><td colspan="6" class="empty">加载中…</td></tr></tbody>
  </table>
</div>

<div class="panel-oj" id="contest-editor" style="display:none">
  <div class="panel-heading flex-between"><span id="editor-title">发布比赛</span><button class="btn btn-default btn-sm" id="editor-close">关闭</button></div>
  <div class="panel-body">
    <div class="grid-2">
      <div class="form-group"><label>比赛标题</label><input class="form-control" id="c-title" placeholder="例：第一场热身赛"></div>
      <div class="form-group"><label>开始时间</label><input class="form-control" id="c-start" type="datetime-local"></div>
    </div>
    <div class="form-group"><label>比赛说明</label><textarea class="form-control" id="c-desc" rows="3" style="height:auto" placeholder="可选"></textarea></div>
    <div class="flex-between"><span class="text-muted" style="font-size:12px">发布后可到「题目管理」为该比赛添加题目</span><button class="btn btn-primary" id="c-save">保存</button></div>
  </div>
</div>

<%- include('../partials/admin-foot', { pageScript: pageScript }) %>
