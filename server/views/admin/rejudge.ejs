<%- include('../partials/admin-head', { title: '重判/抽查', nav: 'rejudge' }) %>
<% var pageScript = '/js/admin/rejudge.js' %>

<h2 class="page-title">重判 / 抽查</h2>

<div class="panel-oj">
  <div class="panel-body">
    <div class="form-group">
      <label>提交 ID（RunID）</label>
      <input class="form-control" id="submission-id" placeholder="提交完整 ID">
    </div>
    <div>
      <button class="btn btn-primary" id="btn-rejudge">重新评测 (Rejudge)</button>
      <button class="btn btn-info" id="btn-spotcheck">跨节点抽查 (Spot Check)</button>
    </div>
    <p class="text-muted mt-16" style="font-size:13px">
      重判：将提交置回 PENDING 重新调度；<br>
      抽查：将提交派发至第二个可信 Worker 重判并比对结果一致性。
    </p>
  </div>
</div>

<div class="panel-oj" id="result-panel" style="display:none">
  <div class="panel-heading">操作结果</div>
  <div class="panel-body mono" id="result-body"></div>
</div>

<%- include('../partials/admin-foot', { pageScript: pageScript }) %>
