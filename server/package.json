{
  "name": "mini-oj-server",
  "version": "1.0.0",
  "description": "Chrome 浏览器本地编译运行 + 服务器 JudgeAdapter 权威判题",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "seed": "node src/seed.js",
    "dev": "node --watch src/app.js",
    "test": "node --test \"test/*.test.js\" \"test/*.test.mjs\"",
    "test:runtime-catalog": "node ../scripts/e2e/runtime-catalog-check.mjs",
    "test:release-smoke": "node ../scripts/e2e/release-readiness-smoke.mjs",
    "test:e2e": "node ../scripts/e2e/oj-main-path.js",
    "test:scoreboard": "node ../scripts/e2e/phase5-scoreboard-sse.js",
    "test:web-runtime": "node test/web-runtime-edge.e2e.js",
    "test:cpp11-browser": "node test/cpp11-warning-compat.e2e.js"
  },
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cookie-parser": "^1.4.6",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  }
}
